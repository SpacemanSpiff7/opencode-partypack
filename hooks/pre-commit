#!/usr/bin/env bash
# pre-commit — run vitest before every commit. --no-verify to bypass.
#
# Installed by `npm install` (which runs the "prepare" script in package.json
# that points git's core.hooksPath at this directory). If you cloned and didn't
# run `npm install` yet, run it now or `git config core.hooksPath hooks` manually.
set -e

cd "$(git rev-parse --show-toplevel)"

# Skip if vitest isn't installed yet (fresh clone, pre-install)
if [[ ! -x node_modules/.bin/vitest ]]; then
  echo "pre-commit: node_modules missing — run \`npm install\` (skipping tests this time)"
  exit 0
fi

echo "pre-commit: running test suite…"
npm test --silent 2>&1 | tail -20
